# ============================================================
# Variables de entorno de Tu Polera (backend)
# Copia este archivo como ".env" y reemplaza los valores.
# NUNCA subas el archivo .env a GitHub.
# ============================================================

# --- MySQL (usuario de la aplicación) ---
DB_USERNAME=tupolera
DB_PASSWORD=cambia-esta-contrasena
# Solo para docker-compose (contraseña del usuario root de MySQL)
MYSQL_ROOT_PASSWORD=cambia-esta-contrasena-root

# --- JWT ---
# Secreto de firma HS256: mínimo 32 caracteres, aleatorio. Debe ser EL MISMO en
# api-gateway, auth-service, catalog-service y sales-service. No se expone al frontend.
# Ejemplo para generarlo (PowerShell):
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=
JWT_ISSUER=tupolera-auth
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- API Gateway ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_SERVICE_URL=http://localhost:8081
CATALOG_SERVICE_URL=http://localhost:8082
SALES_SERVICE_URL=http://localhost:8083

# --- Perfil de Spring (dev | prod) ---
SPRING_PROFILES_ACTIVE=dev
