{
  "info": {
    "name": "Tu Polera - auth-service (vía Gateway)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar primero un Login: el token se guarda en la variable accessToken. Para probar roles, haz login con cada usuario y repite la solicitud."
  },
  "item": [
    {
      "name": "Regiones",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/regiones",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "regiones"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
