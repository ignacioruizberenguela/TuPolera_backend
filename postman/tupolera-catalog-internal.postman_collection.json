    {
      "name": "3. Consulta en lote (200)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Internal-Key",
            "value": "{{internalKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/internal/inventario/consulta",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "internal",
            "inventario",
            "consulta"
          ]
        },
        "description": "Guarda el stock inicial de la talla M del producto 1 para las comprobaciones siguientes.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productoIds\": [\n    1,\n    3,\n    99999\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('99999 no encontrado', () => pm.expect(j.noEncontrados).to.include(99999));",
              "const p = j.productos.find(x => x.id === 1);",
              "pm.test('precioFinal viene del catálogo', () => pm.expect(p.precioFinal).to.eql(Math.round(p.precio - p.precio * p.descuento / 100)));",
              "pm.collectionVariables.set('stockM', p.variantes.find(v => v.talla === 'M').stock);"
            ]
          }
        }
      ]
    },
