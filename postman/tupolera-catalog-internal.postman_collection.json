        "body": {
          "mode": "raw",
          "raw": "{\n  \"referencia\": \"{{refDescuento}}\",\n  \"items\": [\n    {\n      \"productoId\": 1,\n      \"talla\": \"M\",\n      \"cantidad\": 2\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('refDescuento', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('no es repetida', () => pm.expect(j.repetida).to.eql(false));",
              "pm.test('stockActual = inicial - 2', () => pm.expect(j.items[0].stockActual).to.eql(Number(pm.collectionVariables.get('stockM')) - 2));"
            ]
          }
        }
      ]
    },
